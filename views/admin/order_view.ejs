<%- include('../partials/admin_header') %>

<p><a href="/admin/orders">← All Orders</a></p>
<div class="section-title">
  <h1>Order #<%= order.id %></h1>
  <span class="badge badge-<%= order.status %>"><%= order.status[0].toUpperCase() + order.status.slice(1) %></span>
</div>

<div class="product-detail">
  <div>
    <h3>Items</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Product</th><th>Unit Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          <% items.forEach(function(item) { %>
            <tr>
              <td><%= item.product_name %></td>
              <td><%= money(item.unit_price) %></td>
              <td><%= item.quantity %></td>
              <td><%= money(item.line_total) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="summary-line" style="margin-top:1rem;"><span>Subtotal</span><span><%= money(order.subtotal) %></span></div>
    <div class="summary-line"><span>Shipping</span><span><%= money(order.shipping_fee) %></span></div>
    <div class="summary-line total"><span>Total</span><span><%= money(order.total) %></span></div>

    <h3 style="margin-top:1.5rem;">Customer</h3>
    <p><%= order.customer_name %><br><%= order.customer_email %></p>

    <h3>Shipping Address</h3>
    <p><%= order.shipping_name %><br><%= order.shipping_address %><br><%= order.shipping_city %> <%= order.shipping_postcode %><br><%= order.shipping_phone %></p>

    <% if (order.notes) { %><h3>Notes</h3><p style="white-space:pre-line"><%= order.notes %></p><% } %>
  </div>

  <div class="form-card" style="max-width:none;">
    <h3>Update Status</h3>
    <form method="post" action="/admin/orders/<%= order.id %>">
      <%- csrfField() %>
      <div class="field">
        <select name="status">
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s[0].toUpperCase() + s.slice(1) %></option>
          <% }); %>
        </select>
      </div>
      <button class="btn btn-solid" type="submit" style="width:100%;">Update Status</button>
    </form>
  </div>
</div>

<%- include('../partials/admin_footer') %>
