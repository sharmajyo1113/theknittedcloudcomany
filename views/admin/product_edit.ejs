<%- include('../partials/admin_header') %>

<h1><%= product ? 'Edit Product' : 'Add Product' %></h1>

<% errors.forEach(function(err) { %><div class="alert alert-error"><%= err %></div><% }); %>

<form method="post" action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" enctype="multipart/form-data" style="max-width:560px;">
  <%- csrfField() %>
  <div class="field">
    <label for="name">Product Name</label>
    <input type="text" id="name" name="name" value="<%= form.name %>" required>
  </div>
  <div class="field field-row">
    <div>
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id">
        <option value="">— None —</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(form.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label for="sku">SKU</label>
      <input type="text" id="sku" name="sku" value="<%= form.sku %>">
    </div>
  </div>
  <div class="field">
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4"><%= form.description %></textarea>
  </div>
  <div class="field field-row">
    <div>
      <label for="price">Price (₹)</label>
      <input type="number" id="price" name="price" step="0.01" min="0" value="<%= form.price %>" required>
    </div>
    <div>
      <label for="stock">Stock</label>
      <input type="number" id="stock" name="stock" step="1" min="0" value="<%= form.stock %>" required>
    </div>
  </div>
  <div class="field">
    <label for="icon">Illustration Style</label>
    <select id="icon" name="icon">
      <% [['bear','Bear / Toy'],['sheep','Sheep'],['blanket','Blanket'],['cushion','Cushion']].forEach(function(opt) { %>
        <option value="<%= opt[0] %>" <%= form.icon === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
      <% }); %>
    </select>
    <div class="form-help">Used when no photo is uploaded.</div>
  </div>
  <div class="field">
    <label for="image">Product Photo (optional)</label>
    <% if (imagePath) { %><div style="margin-bottom:0.5rem;"><img src="<%= imagePath %>" alt="" style="width:80px;height:80px;object-fit:cover;border-radius:4px;"></div><% } %>
    <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp">
    <div class="form-help">JPEG, PNG or WebP, up to 4MB. Leave blank to keep the illustration above.</div>
  </div>
  <div class="field">
    <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;">
      <input type="checkbox" name="is_active" style="width:auto;" <%= Number(form.is_active) ? 'checked' : '' %>>
      Visible in the store
    </label>
  </div>
  <button class="btn btn-solid" type="submit"><%= product ? 'Save Changes' : 'Create Product' %></button>
  <a class="btn btn-line" href="/admin/products">Cancel</a>
</form>

<%- include('../partials/admin_footer') %>
