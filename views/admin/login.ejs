<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Login — The Knitted Cloud Company</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<main class="wrap page" style="max-width:460px;">
  <h1>Admin Login</h1>
  <div class="form-card">
    <% errors.forEach(function(err) { %><div class="alert alert-error"><%= err %></div><% }); %>
    <form method="post" action="/admin/login">
      <%- csrfField() %>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button class="btn btn-solid" type="submit" style="width:100%;">Log In</button>
    </form>
    <p style="margin-top:1.2rem;font-size:0.8rem;color:var(--ink-soft);">Default admin: admin@theknittedcloudcompany.com / AdminPass123</p>
  </div>
</main>
</body>
</html>
