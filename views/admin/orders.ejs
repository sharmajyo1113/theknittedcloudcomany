<%- include('../partials/admin_header') %>

<h1>Orders</h1>

<div class="chip-row" style="margin-bottom:1.5rem;">
  <a class="chip <%= statusFilter === '' ? 'active' : '' %>" href="/admin/orders">All</a>
  <% statuses.forEach(function(s) { %>
    <a class="chip <%= statusFilter === s ? 'active' : '' %>" href="/admin/orders?status=<%= s %>"><%= s[0].toUpperCase() + s.slice(1) %></a>
  <% }); %>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.customer_name %><br><span style="color:var(--ink-soft);font-size:0.8rem;"><%= o.customer_email %></span></td>
          <td><%= o.created_at %></td>
          <td><%= money(o.total) %></td>
          <td><span class="badge badge-<%= o.status %>"><%= o.status[0].toUpperCase() + o.status.slice(1) %></span></td>
          <td><a href="/admin/orders/<%= o.id %>">View</a></td>
        </tr>
      <% }); %>
      <% if (!orders.length) { %><tr><td colspan="6">No orders found.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin_footer') %>
