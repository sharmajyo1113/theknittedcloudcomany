<%- include('../partials/header') %>

<h1>Order History</h1>

<% if (!orders.length) { %>
  <div class="empty-state">
    <h3>No orders yet</h3>
    <p><a href="/">Start shopping →</a></p>
  </div>
<% } else { %>
  <% orders.forEach(function(order) { %>
    <div class="order-card">
      <div class="head">
        <div>
          <strong>Order #<%= order.id %></strong>
          <span style="color:var(--ink-soft);font-size:0.85rem;"> — <%= order.created_at %></span>
        </div>
        <span class="badge badge-<%= order.status %>"><%= order.status[0].toUpperCase() + order.status.slice(1) %></span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <span><%= money(order.total) %></span>
        <a href="/account/orders/<%= order.id %>">View details →</a>
      </div>
    </div>
  <% }); %>
<% } %>

<%- include('../partials/footer') %>
