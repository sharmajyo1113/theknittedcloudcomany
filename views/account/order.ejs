<%- include('../partials/header') %>

<% if (!order) { %>
  <div class="empty-state"><h3>We couldn't find that order.</h3><p><a href="/account/orders">Back to order history</a></p></div>
<% } else { %>

<p><a href="/account/orders">← Order History</a></p>
<div class="order-card">
  <div class="head">
    <h2 style="margin:0;">Order #<%= order.id %></h2>
    <span class="badge badge-<%= order.status %>"><%= order.status[0].toUpperCase() + order.status.slice(1) %></span>
  </div>
  <p style="color:var(--ink-soft);font-size:0.88rem;">Placed <%= order.created_at %></p>

  <div class="table-wrap" style="margin:1rem 0;">
    <table>
      <thead><tr><th>Product</th><th>Unit Price</th><th>Qty</th><th>Total</th></tr></thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr>
            <td><%= item.product_name %></td>
            <td><%= money(item.unit_price) %></td>
            <td><%= item.quantity %></td>
            <td><%= money(item.line_total) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="summary-line"><span>Subtotal</span><span><%= money(order.subtotal) %></span></div>
  <div class="summary-line"><span>Shipping</span><span><%= order.shipping_fee > 0 ? money(order.shipping_fee) : 'Free' %></span></div>
  <div class="summary-line total"><span>Total</span><span><%= money(order.total) %></span></div>

  <h4 style="margin-top:1.5rem;">Shipping To</h4>
  <p><%= order.shipping_name %><br>
  <%= order.shipping_address %><br>
  <%= order.shipping_city %> <%= order.shipping_postcode %><br>
  <%= order.shipping_phone %></p>

  <% if (order.notes) { %><h4>Notes</h4><p style="white-space:pre-line"><%= order.notes %></p><% } %>
</div>

<% } %>
<%- include('../partials/footer') %>
