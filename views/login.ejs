<%- include('partials/header') %>

<h1>Log In</h1>
<div class="form-card">
  <% errors.forEach(function(err) { %><div class="alert alert-error"><%= err %></div><% }); %>
  <form method="post" action="/login">
    <%- csrfField() %>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autofocus>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required>
    </div>
    <button class="btn btn-solid" type="submit" style="width:100%;">Log In</button>
  </form>
  <p style="margin-top:1.2rem;font-size:0.9rem;">New here? <a href="/register">Create an account</a></p>
  <p style="margin-top:0.4rem;font-size:0.8rem;color:var(--ink-soft);">Demo customer: customer@example.com / Password123</p>
</div>

<%- include('partials/footer') %>
